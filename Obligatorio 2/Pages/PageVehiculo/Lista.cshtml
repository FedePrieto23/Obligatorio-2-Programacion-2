@page
@model Obligatorio_2.Pages.PageVehiculo.ListaModel
@{
}
<div>
    <h1 class="display-4 text-center">Lista de Vehículos</h1>

    <div class="row">
        <div class="col-sm-12 text-right">
            <a class="btn btn-success" asp-page="./Alta">
                <i class="fa fa-plus"></i> Agregar
            </a>
        </div>
    </div>

    <table class="table text-center">
        <thead>
            <tr>
                <td>ID</td>
                <td>Matrícula</td>
                <td>Marca</td>
                <td>Modelo</td>
                <td>Año</td>
                <td>Tipo</td>
                <td>Cap. Pasajeros</td>
                <td>Combustible</td>
                <td>Color</td>
                <td>Precio x Día</td>
                <td>Estado</td>
                <td>Acciones</td>
            </tr>
        </thead>

        <tbody>
            @if (Model.Vehiculos != null && Model.Vehiculos.Any())
            {
                @foreach (var unVeh in Model.Vehiculos)
                {
                    <tr>
                        <td>@unVeh.Id</td>
                        <td>@unVeh.Matricula</td>
                        <td>@unVeh.Marca</td>
                        <td>@unVeh.Modelo</td>
                        <td>@unVeh.Año.ToShortDateString()</td>
                        <td>@unVeh.Tipo</td>
                        <td>@unVeh.CapPasajeros</td>
                        <td>@unVeh.Combustible</td>
                        <td>@unVeh.Color</td>
                        <td>@unVeh.PrecioxDia</td>
                        <td>@unVeh.Estado</td>

                        <td>
                            <div class="mt-2">
                                <a asp-page="./Detalle" class="btn btn-primary"
                                   asp-route-id="@unVeh.Id">
                                    <i class="fa fa-eye"></i>
                                </a>

                                <a asp-page="./Modificar" class="btn btn-warning"
                                   asp-route-id="@unVeh.Id">
                                    <i class="fa fa-edit"></i>
                                </a>

                                <a asp-page="./Baja" class="btn btn-danger"
                                   asp-route-id="@unVeh.Id">
                                    <i class="fa fa-trash-alt"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="12" class="text-center">
                        No hay Vehículos ingresados
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
