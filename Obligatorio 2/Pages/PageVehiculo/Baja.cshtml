@page
@model Obligatorio_2.Pages.PageVehiculo.BajaModel
@{
}
<div class="text-left">
<h1 class="display-4 text-center">Eliminar Vehiculo</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.vehiculo.Id)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.vehiculo.Id)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.vehiculo.Matricula)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.vehiculo.Matricula)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.vehiculo.Marca)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.vehiculo.Marca)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.vehiculo.Modelo)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.vehiculo.Modelo)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.vehiculo.Año)
    </dt>
    <dd class="col-sm-10">
        @Model.vehiculo.Año.ToShortDateString()
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.vehiculo.CapPasajeros)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.vehiculo.CapPasajeros)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.vehiculo.Combustible)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.vehiculo.Combustible)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.vehiculo.Color)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.vehiculo.Color)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.vehiculo.PrecioxDia)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.vehiculo.PrecioxDia)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.vehiculo.Estado)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.vehiculo.Estado)
    </dd>

</dl>
<hr />
<form method="post">
    <input type="hidden" name="id" value="@Model.vehiculo.Id" />
    <div class="row">
        <div class="col-sm-4">
            <button type="submit" class="btn btn-danger"
                    asp-page-handler="Eliminar">
                Eliminar
            </button>
            <a class="btn btn-warning" asp-page="./Lista">Volver</a>
        </div>
    </div>
</form>
</div>