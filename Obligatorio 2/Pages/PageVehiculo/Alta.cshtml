@page
@model Obligatorio_2.Pages.PageVehiculo.AltaModel
@{    
    ViewData["Title"] = "Alta de Vehiculos";
}
<div class="text-left">
    <h1 class="display-4 text-center">Agregar Cliente</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">Id:</label>
                    <input type="text" name="id" id="id" readonly class="form-control" asp-for="id" />
                </div>
                <div class="form-group">
                     <label for="matricula">Matricula:</label>
                     <input type="text" name="matricula" id="matricula" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="marca">Marca:</label>
                    <input type="text" name="marca" id="marca" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="modelo">Modelo:</label>
                    <input type="text" name="modelo" id="modelo" class="form-control"/>
                </div>
                <div class="form-group">
                     <label for="año">Año:</label>
                     <input type="text" name="año" id="año" class="form-control" />
                </div>
                <div class="form-group">
                     <label for="tipo">Tipo:</label>
                     <input type="text" name="tipo" id="tipo" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="cappasajeros">Capacidad de Pasajeros:</label>
                    <input type="number" name="cappasajeros" id="cappasajeros" class="form-control" />
                </div>
                <div class="form-group">
                     <label for="combustible">Combustible:</label>
                     <input type="text" name="combustible" id="combustible" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="color">Color:</label>
                    <input type="text" name="color" id="color" class="form-control" />
                </div>
                <div class="form-group">
                     <label for="precioxdia">Precio por Dia:</label>
                     <input type="number" name="precioxdia" id="precioxdia" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="estado">Estado:</label>
                    <input type="text" name="estado" id="estado" class="form-control" />
                </div>
            </div>
        </div>
        <hr />
        <button type="submit" class="btn btn-success"
                asp-page-handler="Agregar">
            Agregar
        </button>
        <a class="btn btn-warning" asp-page="./Lista">Volver</a>
    </form>
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="row">
            <div class="col-sm-4">
                <br />
                <div class="alert alert-warning" role="alert">
                    @Model.Mensaje
                </div>
            </div>
        </div>
    }
</div>
}
