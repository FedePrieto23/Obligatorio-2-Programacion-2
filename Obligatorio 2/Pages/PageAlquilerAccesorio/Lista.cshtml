@page
@model Obligatorio_2.Pages.PageAlquilerAccesorio.ListaModel
@{
}
<div>
    <h1 class="display-4 text-center">Lista de Accesorios</h1>
    <div class="row">
        <div class="col-sm-12 text-right">
            <a class="btn btn-success" asp-page="./Alta"><i class="fa fa-plus"></i> Agregar</a>
        </div>
    </div>
    <table class="table text-center">
        <thead>
            <tr>
                <td>ID</td>
                <td>Nombre</td>
                <td>Cantidad</td>
                <td>Acciones</td>
            </tr>
        </thead>
        <tbody>
            @if (Model.AlquilerAccesorios != null && Model.AlquilerAccesorios.Any())
            {
                @foreach (var unAlqacc in Model.AlquilerAccesorios)
                {
                    <tr>
                        <td>@unAlqacc.Id</td>
                        <td>@unAlqacc.Nombre</td>
                        <td>@unAlqacc.Cantidad</td>
                        <td>
                            <div class="mt-2">
                                <a asp-page="./Detalle" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Tooltip on top"
                                   asp-route-id="@unAlqacc.Id"><i class="fa fa-eye"></i></a>
                                <a asp-page="./Modificar" class="btn btn-warning"
                                   asp-route-id="@unAlqacc.Id"><i class="fa fa-edit"></i></a>
                                <a asp-page="./Baja" class="btn btn-danger"
                                   asp-route-id="@unAlqacc.Id"><i class="fa fa-trash-alt"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">
                        No hay Accesorios ingresados
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>