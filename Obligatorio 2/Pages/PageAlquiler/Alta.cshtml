@page
@model Obligatorio_2.Pages.PageAlquiiler.AltaModel
@{
    ViewData["Title"] = "Alta de Alquiler";
}
<div class="text-left">
    <h1 class="display-4 text-center">Agregar Alquiler</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">Id:</label>
                    <input type="text" name="id" id="id" readonly class="form-control" asp-for="id" />
                </div>
                <div class="form-group">
                    <label for="fechaalquiler">FechaAlquiler:</label>
                    <input type="text" name="fechaalquiler" id="fechaalquiler" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="fecharetiro">FechaRetiro:</label>
                    <input type="text" name="fecharetiro" id="fecharetiro" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="fechadevov">FechaDevoV:</label>
                    <input type="text" name="fechadevov" id="fechadevov" readonly class="form-control" />
                </div>
                <div class="form-group">
                    <label for="vehiculo">Vehiculo:</label>
                    <input type="text" name="vehiculo" id="vehiculo" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="cliente">Cliente:</label>
                    <input type="text" name="cliente" id="cliente" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="conductorad">ConductorAd:</label>
                    <input type="text" name="conductorad" id="conductorad" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="accesorios">Accesorios:</label>
                    <input type="text" name="accesorios" id="accesorios" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="lugarretiro">LugarRetiro:</label>
                    <input type="text" name="lugarretiro" id="lugarretiro" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="lugardev">LugarDev:</label>
                    <input type="text" name="lugardev" id="lugardev" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="precioxdia;">PrecioXDia;:</label>
                    <input type="text" name="precioxdia" id="precioxdia" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="estado;">Estado;:</label>
                    <input type="text" name="estado" id="estado" class="form-control" />
                </div>
            </div>
        </div>
        <hr />
        <button type="submit" class="btn btn-success"
                asp-page-handler="Agregar">
            Agregar
        </button>
        <a class="btn btn-warning" asp-page="./Lista">Volver</a>
    </form>
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="row">
            <div class="col-sm-4">
                <br />
                <div class="alert alert-warning" role="alert">
                    @Model.Mensaje
                </div>
            </div>
        </div>
    }
</div>
