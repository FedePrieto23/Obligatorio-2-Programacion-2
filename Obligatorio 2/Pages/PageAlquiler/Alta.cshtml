@page
@model Obligatorio_2.Pages.PageAlquiler.AltaModel
@{
}
<div class="text-left">
    <h1 class="display-4 text-center">Agregar Alquiler</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">ID:</label>
                    <input type="text" name="id" id="id" readonly class="form-control" asp-for="id" />
                </div>
                <div class="form-group">
                    <label for="fechaalquiler">Fecha Alquiler:</label>
                    <input type="date" name="fechaalquiler" id="fechaalquiler" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="fecharetirov">Fecha de Retiro:</label>
                    <input type="date" name="fecharetirov" id="fecharetirov" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="fechadevov">Fecha de Devolucion:</label>
                    <input type="date" name="fechadevov" id="fechadevov" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="idVehiculo">Vehiculo:</label>
                    <select id="idVehiculo" name="idVehiculo" class="form-control" onchange="CargoPrecioTotal()">
                        <option value="">Seleccione un vehiculo</option>
                        @foreach (var vehi in Model.vehiculos)
                        {
                            <option value="@vehi.Id">@vehi.Matricula</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="idCliente">Cliente:</label>
                    <select id="idCliente" name="idCliente" class="form-control">
                        <option value="">Seleccione un cliente</option>
                        @foreach (var cli in Model.clientes)
                        {
                            <option value="@cli.Id">@cli.Nombre</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="conductorad">Conductor Adicional:</label>
                    <input type="text" name="conductorad" id="conductorad" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="idAlquileraccesorio">Accesorios:</label>
                    <select id="idAlquileraccesorio" name="idAlquileraccesorio" class="form-control" onchange="CargoPrecioTotal()">
                        <option value="">Seleccione un accesorio</option>
                        @foreach (var Alqacc in Model.alquileraccesorio)
                        {
                            <option value="@Alqacc.Id">@Alqacc.Nombre</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="lugaretiro">Lugar de Retiro:</label>
                    <input type="text" name="lugaretiro" id="lugaretiro" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="lugardev">Lugar de Devolucion:</label>
                    <input type="text" name="lugardev" id="lugardev" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="preciototal">Precio Total:</label>
                    <input type="number" name="preciototal" id="preciototal" class="form-control" readonly />
                </div>
                <div class="form-group">
                    <label for="estado">Estado:</label>
                    <input type="text" name="estado" id="estado" class="form-control" />
                </div>
            </div>
        </div>
        <hr />
        <button type="submit" class="btn btn-success"
                asp-page-handler="Agregar">
            Agregar
        </button>
        <a class="btn btn-warning" asp-page="./Lista">Volver</a>
    </form>
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="row">
            <div class="col-sm-4">
                <br />
                <div class="alert alert-warning" role="alert">
                    @Model.Mensaje
                </div>
            </div>
        </div>
    }
</div>

<script type="text/javascript">
    const vehiculos = @Html.Raw(Json.Serialize(Model.vehiculos));
    const accesorios = @Html.Raw(Json.Serialize(Model.alquileraccesorio));

    function CargoPrecioTotal() {
        var idVehiculo = document.getElementById("idVehiculo").value;
        var idAccesorio = document.getElementById("idAlquileraccesorio").value;

        var precioVehiculo = 0;
        var precioAccesorio = 0;

        if (idVehiculo) {
            const unVeh = vehiculos.find(v => v.id == idVehiculo);
            if (unVeh) {
                precioVehiculo = unVeh.precioxDia;
            }
        }

        if (idAccesorio) {
            const unAcc = accesorios.find(a => a.id == idAccesorio);
            if (unAcc) {
                precioAccesorio = unAcc.precio;
            }
        }

        var importe = 0;

        if (parseInt(precioVehiculo)) {
            importe = importe + parseInt(precioVehiculo);
        }
        if (parseInt(precioAccesorio)) {
            importe = importe + parseInt(precioAccesorio);
        }

        if (importe > 0) {
            document.getElementById("preciototal").value = importe;
        } else {
            document.getElementById("preciototal").value = "";
        }
    }
</script>
