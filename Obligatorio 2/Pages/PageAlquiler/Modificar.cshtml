@page
@model Obligatorio_2.Pages.PageAlquiiler.ModificarModel
@{
    ViewData["Title"] = "Modificar de Alquiler";
}
}
<div class="text-left">
    <h1 class="display-4 text-center">Agregar Alquiler</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">Id:</label>
                    <input type="text" name="id" id="id" readonly class="form-control" 
                        readoonly value="@Model.alquiler.Id"/>
                </div>
                <div class="form-group">
                    <label for="fechaalquiler">Fecha Alquiler:</label>
                    <input type="date" name="fechaalquiler" id="fechaalquiler" class="form-control" 
                        value="@Model.alquiler.FechaAlquiler"/>
                </div>
                <div class="form-group">
                    <label for="fecharetirov">Fecha Retiro:</label>
                    <input type="date" name="fecharetirov" id="fecharetirov" class="form-control" 
                        value="@Model.alquiler.FechaRetiroV"/>
                </div>
                <div class="form-group">
                    <label for="fechadevov">Fecha Devolucion:</label>
                    <input type="date" name="fechadevov" id="fechadevov" readonly class="form-control" 
                        value="@Model.alquiler.FechaDevoV"/>
                </div>
                <div class="form-group">
                    <label for="vehiculo">Vehiculo:</label>
                    <select id="idVehiculo" name="idVehiculo" class="form-control">
                        <option value="">Seleccione un vehiculo</option>
                        @foreach (var vehi in Model.vehiculos)
                        {
                            <option value="@vehi.Id">@vehi.Matricula</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="cliente">Cliente:</label>
                    <select id="idCliente" name="idCliente" class="form-control">
                        <option value="">Seleccione un cliente</option>
                        @foreach (var cli in Model.clientes)
                        {
                            <option value="@cli.Id">@cli.Nombre</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="conductorad">Conductor Adicional:</label>
                    <input type="text" name="conductorad" id="conductorad" class="form-control" 
                        value="@Model.alquiler.ConductorAd"/>
                </div>
                <div class="form-group">
                    <label for="alquileraccesorio">Accesorios:</label>
                    <select id="idAlquileraccesorio" name="idAlquileraccesorio" class="form-control">
                        <option value="">Seleccione un Accesorio</option>
                        @foreach (var Alqacc in Model.alquileraccesorio)
                        {
                            <option value="@Alqacc.Id">@Alqacc.Nombre</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="lugarretiro">Lugar de Retiro:</label>
                    <input type="text" name="lugarretiro" id="lugarretiro" class="form-control" 
                        value="@Model.alquiler.LugarRetiro"/>
                </div>
                <div class="form-group">
                    <label for="lugardev">Lugar de Devolucion:</label>
                    <input type="text" name="lugardev" id="lugardev" class="form-control"
                        value="@Model.alquiler.LugarDev" />
                </div>
                <div class="form-group">
                    <label for="preciototal;">Precio Total;:</label>
                    <input type="number" name="preciototal" id="preciototal" class="form-control" 
                        value="@Model.alquiler.PrecioTotal"/>
                </div>
                <div class="form-group">
                    <label for="estado;">Estado:</label>
                    <input type="text" name="estado" id="estado" class="form-control" 
                        value="@Model.alquiler.Estado"/>
                </div>
            </div>
        </div>
        <hr />
        <button type="submit" class="btn btn-success"
                asp-page-handler="Modificar">
            Agregar
        </button>
        <a class="btn btn-warning" asp-page="./Lista">Volver</a>
    </form>
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="row">
            <div class="col-sm-4">
                <br />
                <div class="alert alert-warning" role="alert">
                    @Model.Mensaje
                </div>
            </div>
        </div>
    }
</div>