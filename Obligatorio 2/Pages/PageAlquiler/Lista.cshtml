@page
@model Obligatorio_2.Pages.PageAlquiiler.ListaModel
@{
}
<div>
    <h1 class="display-4 text-center">Lista de Alquiler</h1>
    <div class="row">
        <div class="col-sm-12 text-right">
            <a class="btn btn-success" asp-page="./Alta"><i class="fa fa-plus"></i> Agregar</a>
        </div>
    </div>
    <table class="table text-center">
        <thead>
            <tr>
                <td>ID</td>
                <td>Fecha de Alquiler</td>
                <td>Fecha de Retiro</td>
                <td>Fecha de Devolucion</td>
                <td>Vehiculo</td>
                <td>Cliente</td>
                <td>Conductor Adicional</td>
                <td>Accesorio</td>
                <td>Lugar de Retiro</td>
                <td>Lugar de Devolucion</td>
                <td>Precio Total</td>
                <td>Estado</td>
                <td>Acciones</td>
            </tr>
        </thead>
        <tbody>
            @if (Model.alquiler != null && Model.alquiler.Any())
            {
                @foreach (var unAlqui in Model.alquiler)
                {
                    <tr>
                        <td>@unAlqui.Id</td>
                        <td>@unAlqui.FechaAlquiler.ToString("yyyy-MM-dd")</td>
                        <td>@unAlqui.FechaRetiroV.ToString("yyyy-MM-dd")</td>
                        <td>@unAlqui.FechaDevoV.ToString("yyyy-MM-dd")</td>
                        <td>@unAlqui.Vehiculo.Matricula</td>
                        <td>@unAlqui.Cliente.Nombre</td>
                        <td>@unAlqui.ConductorAd</td>
                        <td>@unAlqui.AlquilerAccesorio.Nombre</td>
                        <td>@unAlqui.LugarRetiro</td>
                        <td>@unAlqui.LugarDev</td>
                        <td>@unAlqui.PrecioTotal</td>
                        <td>@unAlqui.Estado</td>
                        <td>
                            <div class="mt-2">
                                <a asp-page="./Detalle" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Tooltip on top"
                                   asp-route-id="@unAlqui.Id"><i class="fa fa-eye"></i></a>
                                <a asp-page="./Modificar" class="btn btn-warning"
                                   asp-route-id="@unAlqui.Id"><i class="fa fa-edit"></i></a>
                                <a asp-page="./Baja" class="btn btn-danger"
                                   asp-route-id="@unAlqui.Id"><i class="fa fa-trash-alt"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        No hay Alquileres ingresados
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>