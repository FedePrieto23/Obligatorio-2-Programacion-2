@page
@model Obligatorio_2.Pages.PageAlquiiler.BajaModel
@{
}
<div class="text-left">
    <h1 class="display-4 text-center">Eliminar Alquiler</h1>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.alquiler.Id)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.alquiler.Id)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.alquiler.FechaAlquiler)
    </dt>
    <dd class="col-sm-10">
        @Model.alquiler.FechaAlquiler.ToShortDateString()
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.alquiler.FechaRetiroV)
    </dt>
    <dd class="col-sm-10">
        @Model.alquiler.FechaRetiroV.ToShortDateString()
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.alquiler.FechaDevoV)
    </dt>
    <dd class="col-sm-10">
        @Model.alquiler.FechaDevoV.ToShortDateString()
    </dd>

    <dt class="col-sm-2">
        Vehículo
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(Model => Model.alquiler.Vehiculo.Matricula)
    </dd>

    <dt class="col-sm-2">
        Cliente
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(Model => Model.alquiler.Cliente.Nombre)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(Model => Model.alquiler.ConductorAd)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(Model => Model.alquiler.ConductorAd)
    </dd>

    <dt class="col-sm-2">
        Accesorio
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(Model => Model.alquiler.AlquilerAccesorio.Nombre)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(Model => Model.alquiler.LugarRetiro)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(Model => Model.alquiler.LugarRetiro)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(Model => Model.alquiler.LugarDev)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(Model => Model.alquiler.LugarDev)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(Model => Model.alquiler.PrecioTotal)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(Model => Model.alquiler.PrecioTotal)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(Model => Model.alquiler.Estado)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(Model => Model.alquiler.Estado)
    </dd>
</dl>
    <hr />
    <hr />
    <form method="post">
        <input type="hidden" name="id" value="@Model.alquiler.Id" />
        <div class="row">
            <div class="col-sm-4">
                <button type="submit" class="btn btn-danger"
                        asp-page-handler="Eliminar">
                    Eliminar
                </button>
                <a class="btn btn-warning" asp-page="./Lista">Volver</a>
            </div>
        </div>
    </form>
</div>