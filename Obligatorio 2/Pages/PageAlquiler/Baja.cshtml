@page
@model Obligatorio_2.Pages.PageAlquiiler.BajaModel
@{
}
<div class="text-left">
    <h1 class="display-4 text-center">Detalle de la Venta</h1>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.alquiler.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.alquiler.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.alquiler.FechaAlquiler)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.alquiler.FechaAlquiler)
        </dd>
        <dd class="col-sm-10">
            @Model.alquiler.FechaAlquiler.ToShortDateString()
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.alquiler.FechaRetiroV)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.alquiler.FechaRetiroV)
        </dd>
        <dd class="col-sm-10">
            @Model.alquiler.FechaRetiroV.ToShortDateString()
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.alquiler.FechaDevoV)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.alquiler.FechaDevoV)
        </dd>
        <dd class="col-sm-10">
            @Model.alquiler.FechaDevoV.ToShortDateString()
        </dd>
        <dt class="col-sm-2">
            Vehiculo
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.alquiler.Vehiculo)
        </dd>
        <dt class="col-sm-2">
            Cliente
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.alquiler.Cliente)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.alquiler.ConductorAd)
        </dt>
        <dt class="col-sm-2">
            AlquilerAcessorios
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.alquiler.AlquilerAccesorio)
        </dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.alquiler.LugarRetiro)
        </dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.alquiler.LugarDev)
        </dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.alquiler.PrecioTotal)
        </dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.alquiler.Estado)
        </dd>
    </dl>
    <hr />
    <form method="post">
        <input type="hidden" name="id" value="@Model.alquiler.Id" />
        <div class="row">
            <div class="col-sm-4">
                <button type="submit" class="btn btn-danger"
                        asp-page-handler="Eliminar">
                    Eliminar
                </button>
                <a class="btn btn-warning" asp-page="./Lista">Volver</a>
            </div>
        </div>
    </form>
</div>