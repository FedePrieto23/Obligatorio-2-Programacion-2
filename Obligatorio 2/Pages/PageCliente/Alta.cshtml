@page
@model Obligatorio_2.Pages.PageCliente.AltaModel
@{
    ViewData["Title"] = "Alta de Clientes";
}
<div class="text-left">
    <h1 class="display-4 text-center">Agregar Cliente</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">ID:</label>
                    <input type="text" name="id" id="id" readonly class="form-control" asp-for="id" />
                </div>
                <div class="form-group">
                    <label for="nombre">Nombre:</label>
                    <input type="text" name="nombre" id="nombre" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="direccion">Dirección:</label>
                    <input type="text" name="direccion" id="direccion" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="telefono">Teléfono:</label>
                    <input type="text" name="telefono" id="telefono" class="form-control" />
                </div>
            </div>
        </div>
        <hr />
        <button type="submit" class="btn btn-success"
                asp-page-handler="Agregar">
            Agregar
        </button>
        <a class="btn btn-warning" asp-page="./Lista">Volver</a>
    </form>
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="row">
            <div class="col-sm-4">
                <br />
                <div class="alert alert-warning" role="alert">
                    @Model.Mensaje
                </div>
            </div>
        </div>
    }
</div>
