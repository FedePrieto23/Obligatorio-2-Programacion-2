@page
@model Obligatorio_2.Pages.PageCliente.ModificarModel
@{
}
<div class="text-left">
    <h1 class="display-4 text-center">Modificar Cliente</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="cedula">Cedula:</label>
                    <input type="text" name="cedula" id="cedula" class="form-control" readonly value="@Model.cliente.Cedula" />
                </div>
                <div class="form-group">
                    <label for="fechanac">FechaNac:</label>
                    <input type="text" name="fechanac" id="fechanac" class="form-control" value="@Model.cliente.FechaNac" />
                </div>
                <div class="form-group">
                    <label for="telefono">Teléfono:</label>
                    <input type="text" name="telefono" id="telefono" class="form-control" value="@Model.cliente.Telefono" />
                </div>
                <div class="form-group">
                    <label for="celular">Celular:</label>
                    <input type="text" name="celular" id="celular" class="form-control" value="@Model.cliente.Celular" />
                </div>
                <div class="form-group">
                    <label for="email">Email:</label>
                    <input type="text" name="email" id="email" class="form-control" value="@Model.cliente.Email" />
                </div>
                <div class="form-group">
                    <label for="direccion">Dirección:</label>
                    <input type="text" name="direccion" id="direccion" class="form-control" value="@Model.cliente.Direccion" />
                </div>
                <div class="form-group">
                    <label for="numlibreta">NumLbreta:</label>
                    <input type="text" name="numlibreta" id="numlibreta" class="form-control" value="@Model.cliente.NumLibreta" />
                    <div class="form-group">
                        <label for="fechavenclibreta">FechaVencLibreta:</label>
                        <input type="text" name="fechavenclibreta" id="fechavenclibreta" class="form-control" value="@Model.cliente.FechaVencLibreta" />
                    </div>
                </div>
                
            </div>
        </div>
        <hr />
        <button type="submit" class="btn btn-primary"
                asp-page-handler="Modificar">
            Modificar
        </button>
        <a class="btn btn-warning" asp-page="./Lista">Volver</a>
    </form>
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="row">
            <div class="col-sm-4">
                <br />
                <div class="alert alert-warning" role="alert">
                    @Model.Mensaje
                </div>
            </div>
        </div>
    }
</div>
